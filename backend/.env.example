# NomadsAI backend environment

# Google Gemini Developer API
# Create/manage your key in Google AI Studio: https://aistudio.google.com/apikey
# Keep this key on the backend only. Never expose it as a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated frontend origins. Set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# NomadsAI backend configuration

# Google Gemini is the only supported AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase Auth and user-scoped travel memory.
# The publishable key is safe for public clients. Never use a service_role/secret key here.
SUPABASE_URL=https://ggisuouanswimpvslluf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://ggisuouanswimpvslluf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated frontend origins. Do not use a wildcard in production.
CORS_ORIGINS=http://localhost:3000

# Configure shared Redis storage in production, especially with multiple instances.
RATE_LIMIT_STORAGE_URI=
REDIS_URL=
# Production fails closed without Redis. Only set this to knowingly accept process-local limits.
# ALLOW_IN_MEMORY_RATE_LIMIT=true
# Number of trusted proxies appending to X-Forwarded-For (leave 0 unless verified).
# TRUSTED_PROXY_HOPS=0

# Optional SMTP configuration for the email digest endpoint.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
